# Mizan backend configuration. Copy to `backend/.env` (never commit `.env`).
# Values here are placeholders — do NOT put real secrets in this file.

APP_ENV=development
APP_VERSION=0.1.0
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
# Must match the values in the root .env used by docker-compose.
DATABASE_URL=postgresql+psycopg://mizan:change-me-local-only@localhost:5432/mizan
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# --- LLM provider (assists extraction/classification/analysis/explanation; NEVER an evidence source) ---
# Allowed: none | fake | anthropic   (anthropic adapter is planned, not wired yet)
LLM_PROVIDER=none
LLM_MODEL=
ANTHROPIC_API_KEY=

# --- Trusted sources (placeholders — integration details not yet provided) ---
# Quranpedia: Quran, Tafsir al-Muyassar, Tafsir Ibn Kathir, Asbab al-Wahidi, Al-Muharrar
QURANPEDIA_ENABLED=false
QURANPEDIA_BASE_URL=
QURANPEDIA_API_KEY=
# Dorar al-Sunniyah: hadith data and muhaddith rulings
DORAR_ENABLED=false
DORAR_BASE_URL=
DORAR_API_KEY=
SOURCE_REQUEST_TIMEOUT_SECONDS=15

# Image input / OCR is OUT OF MVP SCOPE (2026-10-04): no OCR settings are used.

# --- Verification pipeline ---
# Implementation default only; NOT a product-level verification rule.
VERIFICATION_MAX_RETRIES=2
